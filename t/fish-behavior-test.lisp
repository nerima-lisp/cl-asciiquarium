;;;; t/fish-behavior-test.lisp -- puffer and lantern behavior.
(in-package #:cl-asciiquarium/test)

(defun behavior-fish (world species x y &key (facing :right) (dx 0))
  (let ((fish (make-fish world :species species :x x :y y :facing facing :dx dx)))
    (cl-asciiquarium::%add-world-creature world fish)
    fish))

(describe "puffer inflation"
  (it "inflates on the next tick at 18 columns and 7 rows, then returns after 45 ticks"
    (with-seeded-random-state (42)
      (let* ((world (hunting-world))
             (puffer (behavior-fish world :puffer 50 17))
             (shark (parked-shark world :x 20 :y 7))
             (center (shark-center puffer)))
        (setf (getf (cl-asciiquarium::creature-data shark) :tick) nil)
        (world-advance world)
        (expect (creature-art puffer) :to-equal cl-asciiquarium::+puffer-big-art+)
        (expect (shark-center puffer) :to-equal center)
        (setf (entity-x (cl-asciiquarium::creature-entity shark)) -100)
        (dotimes (i 44) (world-advance world))
        (expect (getf (cl-asciiquarium::creature-data puffer) :inflated) :to-be t)
        (world-advance world)
        (expect (creature-art puffer) :to-equal
                (cl-asciiquarium::fish-species-entry-art (cl-asciiquarium::fish-species :puffer)))
        (expect (shark-center puffer) :to-equal center))))
  (it "ignores a threat one column or row beyond each of its four edges"
    (with-seeded-random-state (43)
      (dolist (position '((88 40) (29 40) (60 51) (60 29)))
        (let* ((world (make-world :width 160 :height 80 :fish-count 0 :shark-enabled-p nil))
               (puffer (behavior-fish world :puffer 60 40))
               (shark (parked-shark world :x (first position) :y (second position))))
          (setf (getf (cl-asciiquarium::creature-data shark) :tick) nil)
          (world-advance world)
          (expect (getf (cl-asciiquarium::creature-data puffer) :inflated) :to-be nil)))))
  (it "keeps the first deadline and center under repeated alarms, and mirrors both masks"
    (with-seeded-random-state (44)
      (let* ((world (hunting-world))
             (puffer (behavior-fish world :puffer 50 17 :facing :left))
             (center (shark-center puffer)))
        (cl-asciiquarium::puffer-inflate world puffer nil)
        (setf (world-tick world) 10)
        (dotimes (i 20) (cl-asciiquarium::puffer-inflate world puffer nil))
        (expect (getf (cl-asciiquarium::creature-data puffer) :inflate-until) :to-be 45)
        (expect (shark-center puffer) :to-equal center)
        (expect (creature-art puffer) :to-equal
                (mirror-sprite-text cl-asciiquarium::+puffer-big-art+))
        (expect (aref (cl-asciiquarium::creature-%masks puffer) 1) :to-equal
                cl-asciiquarium::+puffer-big-mask+))))
  (it "starts a new 45 tick inflation if a threat remains after the first expires"
    (with-seeded-random-state (45)
      (let* ((world (hunting-world))
             (puffer (behavior-fish world :puffer 50 17))
             (shark (parked-shark world :x 20 :y 7)))
        (setf (getf (cl-asciiquarium::creature-data shark) :tick) nil)
        (dotimes (i 46) (world-advance world))
        (expect (getf (cl-asciiquarium::creature-data puffer) :inflate-until) :to-be 91)
        (expect (creature-art puffer) :to-equal cl-asciiquarium::+puffer-big-art+)))))

(describe "lantern lure"
  (it "attracts each small species from 30 columns away and eats it within 240 ticks"
    (with-seeded-random-state (46)
      (dolist (species '(:dart :guppy :clown))
        (dolist (facing '(:left :right))
          (let* ((world (hunting-world))
                 (lantern (behavior-fish world :lantern 40 14 :facing facing))
                 (fish (behavior-fish world species 77.4f0 20 :dx 0.6f0))
                 (data (cl-asciiquarium::creature-data lantern)))
            (setf (getf data :lure-next) (world-tick world))
            (world-advance world)
            (expect (creature-facing fish) :to-be :left)
            (expect (getf data :lure-target) :to-be fish)
            (loop repeat 239 until (dying-p fish) do (world-advance world))
            (expect (dying-p fish) :to-be t)
            (expect (plusp (cl-asciiquarium::world-refill-at world)) :to-be-truthy))))))
  (it "selects only one fish per 240 ticks and ignores a non-small fish"
    (with-seeded-random-state (47)
      (let* ((world (hunting-world))
             (lantern (behavior-fish world :lantern 40 14))
             (puffer (behavior-fish world :puffer 49 14))
             (farther (behavior-fish world :dart 65 16))
             (nearer (behavior-fish world :guppy 55 16))
             (data (cl-asciiquarium::creature-data lantern)))
        (setf (getf data :lure-next) 1)
        (world-advance world)
        (expect (getf data :lure-target) :to-be nearer)
        (expect (getf data :lure-next) :to-be 241)
        (loop repeat 100 until (dying-p nearer) do (world-advance world))
        (expect (dying-p nearer) :to-be t)
        (loop while (< (world-tick world) 240) do (world-advance world))
        (expect (dying-p farther) :to-be nil)
        (expect (creature-x farther) :to-be 65)
        (expect (creature-x puffer) :to-be 49)
        (expect (getf (cl-asciiquarium::creature-data puffer) :inflated) :to-be nil)
        (world-advance world)
        (expect (getf data :lure-target) :to-be farther))))
  (it "does not select small fish at 31 columns or eat an unselected fish at its light"
    (with-seeded-random-state (48)
      (let* ((world (hunting-world))
             (lantern (behavior-fish world :lantern 40 14))
             (far (behavior-fish world :dart 79 14))
             (data (cl-asciiquarium::creature-data lantern)))
        (setf (getf data :lure-next) 1)
        (world-advance world)
        (expect (getf data :lure-target) :to-be nil)
        (expect (creature-x far) :to-be 79)
        (let ((near (behavior-fish world :clown 44 13)))
          (world-advance world)
          (expect (dying-p near) :to-be nil)))))
  (it "keeps an attracted fish swimming if its lantern dies"
    (with-seeded-random-state (49)
      (let* ((world (hunting-world))
             (lantern (behavior-fish world :lantern 40 14))
             (fish (behavior-fish world :dart 65 16 :dx 0.5f0)))
        (setf (getf (cl-asciiquarium::creature-data lantern) :lure-next) 1)
        (world-advance world)
        (cl-asciiquarium::kill-fish lantern)
        (let ((x (creature-x fish)))
          (world-advance world)
          (expect (creature-x fish) :to-be (+ x 0.5f0)))))))

(describe "lantern light"
  (it "blinks normally and keeps the first frame under calm"
    (with-seeded-random-state (50)
      (let* ((world (hunting-world))
             (lantern (behavior-fish world :lantern 40 14))
             (first (creature-art lantern)))
        (dotimes (i 6) (world-advance world))
        (expect (equal first (creature-art lantern)) :to-be nil)
        (expect (creature-art lantern) :to-equal cl-asciiquarium::+lantern-dim-art+)))
    (with-seeded-random-state (50)
      (let* ((world (make-world :width 120 :height 30 :fish-count 0
                                :shark-enabled-p nil :calm-p t))
             (lantern (behavior-fish world :lantern 40 14))
             (first (creature-art lantern)))
        (expect (cl-asciiquarium::creature-frame-period lantern) :to-be nil)
        (dotimes (i 12) (world-advance world))
        (expect (creature-art lantern) :to-equal first))))
  (it "creates a following glow only at night and removes it at day or after death"
    (with-seeded-random-state (51)
      (let* ((world (hunting-world))
             (lantern (behavior-fish world :lantern 40 14 :dx 0.15f0)))
        (world-advance world)
        (expect (getf (cl-asciiquarium::creature-data lantern) :glow) :to-be nil)
        (world-set-theme world :moonlight)
        (world-advance world)
        (let ((glow (getf (cl-asciiquarium::creature-data lantern) :glow)))
          (expect (find #\· (creature-art glow)) :to-be-truthy)
          (expect (member glow (cl-asciiquarium::world-%creatures world)) :to-be-truthy)
          (expect (creature-x glow) :to-be (+ (creature-x lantern) 4))
          (world-set-theme world :coral)
          (dotimes (i 2) (world-advance world))
          (expect (member glow (cl-asciiquarium::world-%creatures world)) :to-be nil))
        (world-set-theme world :moonlight)
        (world-advance world)
        (let ((glow (getf (cl-asciiquarium::creature-data lantern) :glow)))
          (cl-asciiquarium::kill-fish lantern)
          (world-advance world)
          (expect (cl-asciiquarium::creature-removep glow) :to-be t)))))
  (it "uses ASCII replacement for the night halo"
    (with-seeded-random-state (52)
      (let* ((cl-asciiquarium::*ascii* t)
             (world (hunting-world))
             (lantern (behavior-fish world :lantern 40 14)))
        (world-set-theme world :moonlight)
        (world-advance world)
        (let ((glow (getf (cl-asciiquarium::creature-data lantern) :glow)))
          (expect (find #\· (creature-art glow)) :to-be nil)
          (expect (every (lambda (ch) (< (char-code ch) 128)) (creature-art glow))
                  :to-be t)))))
  (it "allocates no memory across advancing ticks including puffer returns and target selection"
    (with-seeded-random-state (53)
      (let* ((world (hunting-world))
             (puffer (behavior-fish world :puffer 20 14))
             (lantern (behavior-fish world :lantern 60 14))
             (returns 0))
        (setf (getf (cl-asciiquarium::creature-data puffer) :bubble-timer) 100000
              (getf (cl-asciiquarium::creature-data lantern) :bubble-timer) 100000)
        (cl-asciiquarium::puffer-inflate world puffer nil)
        (let ((before (sb-ext:get-bytes-consed)))
          (dotimes (i 10000)
            (incf (world-tick world))
            (cl-asciiquarium::puffer-tick world puffer)
            (unless (getf (cl-asciiquarium::creature-data puffer) :inflated)
              (incf returns))
            (cl-asciiquarium::lantern-tick world lantern)
            (cl-asciiquarium::puffer-inflate world puffer nil))
          (expect (- (sb-ext:get-bytes-consed) before) :to-be 0))
        (expect returns :to-be 222)
        (expect (getf (cl-asciiquarium::creature-data lantern) :lure-next) :to-be 10080)))))

(describe "lantern steady state"
  (it "keeps the random sequence unchanged under calm"
    (let ((results
            (loop for calm in '(nil t)
                  collect
                  (with-seeded-random-state (54)
                    (let* ((world (make-world :width 120 :height 30 :fish-count 0
                                             :shark-enabled-p nil :calm-p calm))
                           (lantern (behavior-fish world :lantern 40 14)))
                      (declare (ignore lantern))
                      (dotimes (i 12) (world-advance world))
                      (loop repeat 8 collect (random 1000000)))))))
      (expect (first results) :to-equal (second results))))
  (it "allocates no memory across moving night ticks and repeated target selection"
    (with-seeded-random-state (55)
      (let* ((world (hunting-world))
             (lantern (behavior-fish world :lantern 40 14 :dx 0.15f0))
             (fish (behavior-fish world :dart 65 16))
             (data (cl-asciiquarium::creature-data lantern)))
        (world-set-theme world :moonlight)
        (setf (getf data :lure-next) 0
              (getf data :bubble-timer) 100000)
        (cl-asciiquarium::lantern-tick world lantern)
        (expect (getf data :lure-target) :to-be fish)
        (let ((glow (getf data :glow)) (aligned t))
          (expect glow :to-be-truthy)
          (let ((before (sb-ext:get-bytes-consed)))
            (dotimes (i 10000)
              (incf (world-tick world))
              (cl-asciiquarium::lantern-glow-tick world glow)
              (cl-asciiquarium::tick-creature world lantern 120 30)
              (unless (and (= (creature-x glow) (+ (creature-x lantern) 4))
                           (= (creature-y glow) (1- (creature-y lantern))))
                (setf aligned nil)))
            (expect (- (sb-ext:get-bytes-consed) before) :to-be 0))
          (expect aligned :to-be t)
          (expect (getf data :lure-next) :to-be 10080)
          (expect (cl-asciiquarium::creature-removep glow) :to-be nil))))))

(describe "lantern range and release"
  (it "includes 30 columns and 8 rows but excludes one cell beyond every edge"
    (with-seeded-random-state (56)
      (dolist (position '((78 42 t) (4 19 t) (79 30 nil) (3 30 nil)
                          (60 43 nil) (60 18 nil)))
        (let* ((world (make-world :width 160 :height 80 :fish-count 0 :shark-enabled-p nil))
               (lantern (behavior-fish world :lantern 40 30))
               (fish (behavior-fish world :dart (first position) (second position)))
               (data (cl-asciiquarium::creature-data lantern)))
          (setf (getf data :lure-next) 1)
          (world-advance world)
          (expect (eq (getf data :lure-target) fish) :to-be (third position))))))
  (it "restores velocity-facing immediately when the lantern dies in daylight"
    (with-seeded-random-state (57)
      (dolist (position '((65 0.5f0 :right :left) (20 -0.5f0 :left :right)))
        (let* ((world (hunting-world))
               (lantern (behavior-fish world :lantern 40 14))
               (fish (behavior-fish world :dart (first position) 16 :dx (second position))))
          (setf (getf (cl-asciiquarium::creature-data lantern) :lure-next) 1)
          (world-advance world)
          (expect (creature-facing fish) :to-be (fourth position))
          (cl-asciiquarium::kill-fish lantern)
          (expect (creature-facing fish) :to-be (third position))
          (expect (getf (cl-asciiquarium::creature-data lantern) :lure-target) :to-be nil)))))
  (it "restores velocity-facing before eating and when an old target leaves the range"
    (with-seeded-random-state (58)
      (dolist (eat '(t nil))
        (let* ((world (hunting-world))
               (lantern (behavior-fish world :lantern 40 14))
               (fish (behavior-fish world :dart 65 16 :dx 0.5f0))
               (data (cl-asciiquarium::creature-data lantern)))
          (setf (getf data :lure-next) 1)
          (world-advance world)
          (expect (creature-facing fish) :to-be :left)
          (if eat
              (progn
                (loop repeat 239 until (dying-p fish) do (world-advance world))
                (expect (dying-p fish) :to-be t))
              (progn
                (setf (entity-x (cl-asciiquarium::creature-entity fish)) 100
                      (world-tick world) 240)
                (world-advance world)))
          (expect (getf data :lure-target) :to-be nil)
          (expect (creature-facing fish) :to-be :right)))))
  (it "uses small-p from new species entries for both selection and capture"
    (with-seeded-random-state (65)
      (let* ((small (cl-asciiquarium::copy-fish-species-entry (cl-asciiquarium::fish-species :dart)))
             (large (cl-asciiquarium::copy-fish-species-entry small))
             (cl-asciiquarium::+fish-species+ (list* small large cl-asciiquarium::+fish-species+))
             (cl-asciiquarium::*fish-sprite-prototypes* (make-hash-table :test #'eq)))
        (setf (cl-asciiquarium::fish-species-entry-name small) :test-small
              (cl-asciiquarium::fish-species-entry-small-p small) t
              (cl-asciiquarium::fish-species-entry-name large) :test-large
              (cl-asciiquarium::fish-species-entry-small-p large) nil)
        (let* ((world (hunting-world))
               (lantern (behavior-fish world :lantern 40 14))
               (non-small (behavior-fish world :test-large 49 16))
               (prey (behavior-fish world :test-small 65 16))
               (data (cl-asciiquarium::creature-data lantern)))
          (setf (getf data :lure-next) 1)
          (world-advance world)
          (expect (getf data :lure-target) :to-be prey)
          (loop repeat 239 until (dying-p prey) do (world-advance world))
          (expect (dying-p prey) :to-be t)
          (expect (cl-asciiquarium::alive-fish-p non-small) :to-be t)
          (expect (creature-x non-small) :to-be 49))))))

(describe "lantern lifetime and following"
  (it "follows every moved parent tick through wrapping and either tick order"
    (with-seeded-random-state (59)
      (dolist (glow-first '(t nil))
        (dolist (facing '(:left :right))
          (let* ((world (hunting-world))
                 (lantern (behavior-fish world :lantern (if (eq facing :right) 119 1)
                                        14 :facing facing
                                        :dx (if (eq facing :right) 0.5f0 -0.5f0))))
            (world-set-theme world :moonlight)
            (world-advance world)
            (let ((glow (getf (cl-asciiquarium::creature-data lantern) :glow))
                  (wrapped nil))
              (unless glow-first
                (cl-asciiquarium::%set-world-creatures
                 world (append (remove glow (cl-asciiquarium::world-%creatures world))
                               (list glow))))
              (dotimes (i 50)
                (let ((x (creature-x lantern)))
                  (world-advance world)
                  (when (> (abs (- (creature-x lantern) x)) 10) (setf wrapped t)))
                (expect (creature-x glow)
                        :to-be (+ (creature-x lantern) (if (eq facing :right) 4 -1)))
                (expect (creature-y glow) :to-be (1- (creature-y lantern)))
                (expect (cl-asciiquarium::creature-removep glow) :to-be nil))
              (expect wrapped :to-be t)))))))

  (it "releases targets on the real minus-key path in day and night"
    (with-seeded-random-state (61)
      (dolist (theme '(:coral :moonlight))
        (let* ((world (hunting-world))
               (fish (behavior-fish world :dart 65 16 :dx 0.5f0))
               (lantern (behavior-fish world :lantern 40 14)))
          (world-set-theme world theme)
          (setf (cl-asciiquarium::world-fish-count world) 2
                (getf (cl-asciiquarium::creature-data lantern) :lure-next) 1)
          (world-advance world)
          (expect (creature-facing fish) :to-be :left)
          (world-apply-key-event world (first (decode-input "-")))
          (expect (cl-asciiquarium::creature-removep lantern) :to-be t)
          (expect (creature-facing fish) :to-be :right)
          (dotimes (i 2) (world-advance world))
          (expect (member lantern (cl-asciiquarium::world-%creatures world)) :to-be nil)
          (expect (find :lantern-glow (cl-asciiquarium::world-%creatures world)
                        :key #'cl-asciiquarium::creature-kind) :to-be nil))))))

(describe "prepared species frames"
  (it "shares both prepared lantern frames between fish"
    (with-seeded-random-state (62)
      (let* ((world (hunting-world))
             (first (behavior-fish world :lantern 20 14))
             (second (behavior-fish world :lantern 60 14)))
        (expect (length (cl-asciiquarium::creature-%frames first)) :to-be 2)
        (expect (cl-asciiquarium::creature-%prepared-frames first)
                :to-be (cl-asciiquarium::creature-%prepared-frames second))
        (expect (cl-asciiquarium::creature-%frame-runs first)
                :to-be (cl-asciiquarium::creature-%frame-runs second)))))
  (it "keeps the inflated puffer through restyling without automatic animation"
    (with-seeded-random-state (63)
      (let* ((world (hunting-world))
             (puffer (behavior-fish world :puffer 40 14)))
        (cl-asciiquarium::puffer-inflate world puffer nil)
        (expect (cl-asciiquarium::creature-frame-period puffer) :to-be nil)
        (world-set-theme world :moonlight)
        (dotimes (i 10) (world-advance world))
        (expect (creature-art puffer) :to-equal cl-asciiquarium::+puffer-big-art+)
        (expect (cl-asciiquarium::creature-frame-index puffer) :to-be 1)))))

(describe "lantern school selection"
  (it "skips a school leader while still attracting its followers"
    (with-seeded-random-state (64)
      (let* ((world (hunting-world))
             (lantern (behavior-fish world :lantern 40 14))
             (leader (behavior-fish world :dart 49 16))
             (follower (behavior-fish world :dart 65 16)))
        (setf (cl-asciiquarium::creature-data leader)
              (list* :leader leader (cl-asciiquarium::creature-data leader))
              (cl-asciiquarium::creature-data follower)
              (list* :leader leader (cl-asciiquarium::creature-data follower))
              (getf (cl-asciiquarium::creature-data lantern) :lure-next) 1)
        (world-advance world)
        (expect (getf (cl-asciiquarium::creature-data lantern) :lure-target)
                :to-be follower)
        (expect (creature-x leader) :to-be 49)
        (expect (creature-facing follower) :to-be :left)))))

(describe "paused lantern removal"
  (it "removes the lantern and its glow on the next advance after minus while paused"
    (with-seeded-random-state (66)
      (let* ((world (hunting-world))
             (fish (behavior-fish world :dart 65 16 :dx 0.5f0))
             (lantern (behavior-fish world :lantern 40 14)))
        (world-set-theme world :moonlight)
        (setf (cl-asciiquarium::world-fish-count world) 2
              (getf (cl-asciiquarium::creature-data lantern) :lure-next) 1)
        (world-advance world)
        (let ((glow (getf (cl-asciiquarium::creature-data lantern) :glow))
              (tick (world-tick world))
              (fish-x (creature-x fish)))
          (expect glow :to-be-truthy)
          (world-apply-key-event world (first (decode-input " ")))
          (expect (world-paused-p world) :to-be t)
          (world-apply-key-event world (first (decode-input "-")))
          (expect (cl-asciiquarium::creature-removep lantern) :to-be t)
          (expect (cl-asciiquarium::creature-removep glow) :to-be t)
          (expect (creature-facing fish) :to-be :right)
          (world-advance world)
          (expect (world-tick world) :to-be tick)
          (expect (creature-x fish) :to-be fish-x)
          (expect (member lantern (cl-asciiquarium::world-%creatures world)) :to-be nil)
          (expect (member glow (cl-asciiquarium::world-%creatures world)) :to-be nil))))))

(describe "the lantern glow attached to its lantern"
  (it "leaves with its lantern when the lantern dies, on r, and on minus"
    (dolist (exit '(:death :redraw :minus))
      (with-seeded-random-state (66)
        (let* ((world (hunting-world))
               (lantern (behavior-fish world :lantern 40 14)))
          (world-set-theme world :moonlight)
          (setf (cl-asciiquarium::world-fish-count world) 1)
          (world-advance world)
          (let ((glow (getf (cl-asciiquarium::creature-data lantern) :glow)))
            (expect (and glow t) :to-be t)
            (ecase exit
              (:death (cl-asciiquarium::eat-effect world nil lantern))
              (:redraw (world-redraw world))
              (:minus (world-apply-key-event world (first (decode-input "-")))))
            (expect (list exit (cl-asciiquarium::creature-removep glow)) :to-equal (list exit t))
            (expect (list exit (null (getf (cl-asciiquarium::creature-data lantern) :attached)))
                    :to-equal (list exit t))
            (world-advance world)
            (expect (list exit (and (member glow (cl-asciiquarium::world-%creatures world)) t))
                    :to-equal (list exit nil))))))))
