;;;; t/submarine-test.lisp -- the submarine, its sonar rings, and the stun.
(in-package #:cl-asciiquarium/test)

(defvar *sub-allocation-sink* nil)

(defun sub-test-world (&key (width 80) (height 24))
  ;; The tests stay well before the first automatic school (tick 600).
  (let ((world (make-world :width width :height height :fish-count 0
                           :shark-enabled-p nil :hud-visible-p nil)))
    (setf (cl-asciiquarium::world-guest-cooldown world) most-positive-fixnum)
    world))

(defmacro sub-data (creature)
  `(cl-asciiquarium::creature-data ,creature))

(defun sub-entity (creature)
  (cl-asciiquarium::creature-entity creature))

(defun creatures-of-kind (world kind)
  (remove-if-not (lambda (creature) (eq (cl-asciiquarium::creature-kind creature) kind))
                 (cl-asciiquarium::world-%creatures world)))

(defun parked-sub (world &key (x 30))
  "A submarine standing still at column X, its first ring due next tick."
  (let ((sub (cl-asciiquarium::spawn-submarine-now world)))
    (setf (entity-x (sub-entity sub)) x
          (entity-dx (sub-entity sub)) 0
          (getf (sub-data sub) :sonar-next) (1+ (world-tick world)))
    sub))

(defun stunned-p (fish)
  (getf (sub-data fish) :stunned-until))

(defun advance-until-stunned (world fish)
  (loop repeat 40
        until (stunned-p fish)
        do (world-advance world))
  (stunned-p fish))

(describe "the submarine"
  (it "enters off screen from either side at 0.35 columns per tick near row 20"
    (let ((facings '()))
      (dolist (seed '(1 2 3 4 5 6))
        (with-seeded-random-state (seed)
          (let* ((world (sub-test-world))
                 (sub (cl-asciiquarium::spawn-submarine-now world))
                 (x (creature-x sub))
                 (dx (entity-dx (sub-entity sub))))
            (pushnew (creature-facing sub) facings)
            (expect (eq (cl-asciiquarium::creature-kind sub) :sub) :to-be-truthy)
            (expect (abs dx) :to-be 0.35f0)
            (if (eq (creature-facing sub) :right)
                (expect (and (plusp dx) (<= (+ x (creature-dimensions sub)) 0)) :to-be-truthy)
                (expect (and (minusp dx) (>= x 80)) :to-be-truthy))
            ;; 24 rows: the swim band's last row is 19, so the 4-row sprite tops out at 16.
            (expect (creature-y sub) :to-be 16)
            (world-advance world)
            (expect (< (abs (- (creature-x sub) x dx)) 1.0e-4) :to-be-truthy)
            (expect (member sub (cl-asciiquarium::world-%creatures world)) :to-be-truthy))))
      (expect (length facings) :to-be 2)))
  (it "emits a ring every 50 ticks from its spawn and removes each ring after its last frame"
    (with-seeded-random-state (3)
      (let* ((world (sub-test-world :width 400))
             (sub (cl-asciiquarium::make-submarine world :facing :right)))
        (cl-asciiquarium::%add-world-creature world sub)
        (expect (getf (sub-data sub) :sonar-next) :to-be 50)
        (dotimes (tick 49) (world-advance world))
        (expect (creatures-of-kind world :sonar) :to-be nil)
        (world-advance world)
        (let ((rings (creatures-of-kind world :sonar)))
          (expect (length rings) :to-be 1)
          (expect (getf (sub-data sub) :sonar-next) :to-be 100)
          (let* ((ring (first rings))
                 (centre (getf (sub-data ring) :centre-x)))
            (expect (< (abs (- centre (creature-x sub) 7)) 1.0e-4) :to-be-truthy)
            (expect (creature-y ring) :to-be (creature-y sub))
            (expect (creature-dimensions ring) :to-be 3)
            (dotimes (tick 23)
              (world-advance world)
              (expect (< (abs (- (+ (creature-x ring) (* 0.5f0 (creature-dimensions ring)))
                                 centre))
                         1.0e-4)
                      :to-be-truthy))
            (expect (creature-dimensions ring) :to-be 25)
            (expect (getf (sub-data ring) :threat) :to-be cl-asciiquarium::+sonar-threat+)
            (world-advance world)
            (expect (cl-asciiquarium::creature-removep ring) :to-be-truthy)
            (expect (getf (sub-data ring) :threat) :to-be nil)
            (expect (creatures-of-kind world :sonar) :to-be nil)))
        (dotimes (tick 25) (world-advance world))
        (expect (creatures-of-kind world :sonar) :to-be nil)
        (world-advance world)
        (expect (world-tick world) :to-be 100)
        (expect (length (creatures-of-kind world :sonar)) :to-be 1)
        (expect (getf (sub-data sub) :sonar-next) :to-be 150))))
  (it "does not cons on a tick with no ring due, nor while a ring or a mark follows"
    (with-seeded-random-state (3)
      (let* ((world (sub-test-world))
             (sub (parked-sub world))
             (ring (cl-asciiquarium::make-sonar-ring world sub))
             (fish (make-fish world :species :dart :x 10 :y 10 :dx 0.3 :facing :right))
             (mark (cl-asciiquarium::make-stun-mark world fish)))
        (setf (getf (sub-data sub) :sonar-next) most-positive-fixnum)
        (cl-asciiquarium::stun-effect world ring fish)
        (flet ((bytes-consed (function creature)
                 (dotimes (i 100) (funcall function world creature))
                 (let ((before (sb-ext:get-bytes-consed)))
                   (dotimes (i 10000) (funcall function world creature))
                   (- (sb-ext:get-bytes-consed) before))))
          (expect (bytes-consed 'cl-asciiquarium::sub-tick sub) :to-be 0)
          (expect (bytes-consed 'cl-asciiquarium::sonar-tick ring) :to-be 0)
          (expect (bytes-consed 'cl-asciiquarium::stun-mark-tick mark) :to-be 0)
          (let ((before (sb-ext:get-bytes-consed)))
            (dotimes (i 10000) (setf *sub-allocation-sink* (list i)))
            (expect (plusp (- (sb-ext:get-bytes-consed) before)) :to-be-truthy))))))
  (it "draws left- and right-facing art whose masks cover exactly its glyphs"
    (with-seeded-random-state (3)
      (let ((world (sub-test-world)))
        (dolist (facing '(:right :left))
          (let* ((sub (cl-asciiquarium::make-submarine world :facing facing))
                 (art (creature-art sub))
                 (mask (aref (if (eq facing :left)
                                 (cl-asciiquarium::creature-%mirrored-masks sub)
                                 (cl-asciiquarium::creature-%masks sub))
                             0)))
            (expect (equal art (if (eq facing :left)
                                   (mirror-sprite-text cl-asciiquarium::+sub-art+)
                                   cl-asciiquarium::+sub-art+))
                    :to-be-truthy)
            (expect (multiple-value-list (sprite-dimensions art))
                    :to-equal (multiple-value-list (sprite-dimensions mask)))
            (loop for art-line in (cl-asciiquarium::split-sprite-lines art)
                  for mask-line in (cl-asciiquarium::split-sprite-lines mask)
                  do (expect (length art-line) :to-be (length mask-line))
                     (expect (every (lambda (glyph role)
                                      (eq (char= glyph #\Space) (char= role #\Space)))
                                    art-line mask-line)
                             :to-be-truthy)))))))
  (it "recolors the submarine, its rings, and marks for a new theme"
    (with-seeded-random-state (3)
      (let ((*color-mode* :truecolor))
        (let* ((world (sub-test-world))
               (sub (parked-sub world))
               (ring (cl-asciiquarium::make-sonar-ring world sub))
               (fish (make-fish world :species :dart :x 10 :y 10)))
          (cl-asciiquarium::%add-world-creature world ring)
          (cl-asciiquarium::%add-world-creature world fish)
          (cl-asciiquarium::stun-effect world ring fish)
          (world-set-theme world :moonlight)
          (expect (equalp (creature-style ring) (color-style :sonar :theme :moonlight))
                  :to-be-truthy)
          (expect (equalp (creature-style sub) (color-style :fg :theme :moonlight))
                  :to-be-truthy)
          (expect (equalp (creature-style (first (creatures-of-kind world :stun-mark)))
                          (cl-asciiquarium::world-style world :yellow))
                  :to-be-truthy))))))

(describe "the sonar stun"
  (it "stops a fish the ring passes for 25 ticks under a ! and gives back its dx on tick 26"
    (with-seeded-random-state (8)
      (let* ((world (sub-test-world))
             (sub (parked-sub world))
             (fish (make-fish world :species :dart :x 47 :y 17 :dx -0.3 :facing :left)))
        (declare (ignore sub))
        (cl-asciiquarium::%add-world-creature world fish)
        (expect (advance-until-stunned world fish) :to-be-truthy)
        (let ((x (creature-x fish))
              (mark (first (creatures-of-kind world :stun-mark))))
          (expect (cl-asciiquarium::alive-fish-p fish) :to-be-truthy)
          (expect (getf (sub-data mark) :fish) :to-be fish)
          (expect (creature-x mark) :to-be x)
          (expect (creature-y mark) :to-be 16)
          (dotimes (tick 24)
            (world-advance world)
            (expect (entity-dx (sub-entity fish)) :to-be 0)
            (expect (creature-x fish) :to-be x)
            (expect (creatures-of-kind world :stun-mark) :to-equal (list mark)))
          (world-advance world)
          (expect (entity-dx (sub-entity fish)) :to-be -0.3)
          (expect (creature-facing fish) :to-be :left)
          (expect (cl-asciiquarium::creature-removep mark) :to-be-truthy)
          (expect (creatures-of-kind world :stun-mark) :to-be nil)))))
  (it "marks a right-facing fish above its head and restores the facing its dx swims"
    (with-seeded-random-state (8)
      (let* ((world (sub-test-world))
             (sub (parked-sub world))
             (fish (make-fish world :species :dart :x 20 :y 18 :dx 0.3 :facing :right)))
        (declare (ignore sub))
        (cl-asciiquarium::%add-world-creature world fish)
        (expect (advance-until-stunned world fish) :to-be-truthy)
        (let ((mark (first (creatures-of-kind world :stun-mark))))
          (expect (creature-x mark) :to-be (+ (creature-x fish) (1- (creature-dimensions fish))))
          (expect (creature-y mark) :to-be 17)
          ;; A lantern pull turns a fish without touching its dx.
          (setf (cl-asciiquarium::creature-facing fish) :left)
          (dotimes (tick 25) (world-advance world))
          (expect (entity-dx (sub-entity fish)) :to-be 0.3)
          (expect (creature-facing fish) :to-be :right)))))
  (it "ignores a second ring while stunned and stuns again once the stun is over"
    (with-seeded-random-state (8)
      (let* ((world (sub-test-world))
             (fish (make-fish world :species :dart :x 10 :y 10 :dx 0.3 :facing :right)))
        (cl-asciiquarium::%add-world-creature world fish)
        (cl-asciiquarium::stun-effect world nil fish)
        (let ((until (stunned-p fish))
              (length (length (sub-data fish))))
          (world-advance world)
          (cl-asciiquarium::stun-effect world nil fish)
          (expect (stunned-p fish) :to-be until)
          (expect (length (creatures-of-kind world :stun-mark)) :to-be 1)
          (dotimes (tick 24) (world-advance world))
          (expect (entity-dx (sub-entity fish)) :to-be 0.3)
          (cl-asciiquarium::stun-effect world nil fish)
          (expect (stunned-p fish) :to-be (+ (world-tick world) 25))
          (expect (entity-dx (sub-entity fish)) :to-be 0)
          (expect (length (sub-data fish)) :to-be length)))))
  (it "leaves no mark behind a fish eaten while stunned"
    (with-seeded-random-state (8)
      (let* ((world (sub-test-world))
             (fish (make-fish world :species :dart :x 10 :y 10 :dx 0.3 :facing :right)))
        (cl-asciiquarium::%add-world-creature world fish)
        (cl-asciiquarium::stun-effect world nil fish)
        (world-advance world)
        (let ((mark (first (creatures-of-kind world :stun-mark))))
          (cl-asciiquarium::eat-effect world nil fish)
          (world-advance world)
          (expect (cl-asciiquarium::creature-removep mark) :to-be-truthy)
          (expect (creatures-of-kind world :stun-mark) :to-be nil)
          (dotimes (tick 30) (world-advance world))
          (expect (creatures-of-kind world :stun-mark) :to-be nil)))))
  (it "takes the ! away with a stunned fish removed by minus while paused"
    (with-seeded-random-state (8)
      (let* ((world (sub-test-world))
             (fish (make-fish world :species :dart :x 10 :y 10 :dx 0.3 :facing :right)))
        (cl-asciiquarium::%add-world-creature world fish)
        (setf (cl-asciiquarium::world-fish-count world) 1)
        (cl-asciiquarium::stun-effect world nil fish)
        (world-advance world)
        (expect (length (creatures-of-kind world :stun-mark)) :to-be 1)
        (world-apply-key-event world (first (decode-input " ")))
        (expect (world-paused-p world) :to-be t)
        (world-apply-key-event world (first (decode-input "-")))
        (world-advance world)
        (expect (cl-asciiquarium::creature-removep fish) :to-be t)
        (expect (length (creatures-of-kind world :stun-mark)) :to-be 0))))
  (it "takes the ! away with a stunned fish a shark kills, when paused on the next key"
    (with-seeded-random-state (77)
      (let* ((world (sub-test-world :width 100 :height 30))
             (fish (make-fish world :species :dart :x 40 :y 12 :dx 0.3 :facing :right))
             (shark (make-shark world :facing :right)))
        (cl-asciiquarium::%set-world-creatures world (list fish shark))
        (setf (entity-x (sub-entity shark)) (- 41 (cl-asciiquarium::creature-dimensions shark))
              (entity-y (sub-entity shark)) 12)
        ;; The mark goes ahead of the fish, so its own tick has already run
        ;; when the collision releases it.
        (cl-asciiquarium::stun-effect world nil fish)
        (let ((mark (first (creatures-of-kind world :stun-mark))))
          (world-advance world)
          (expect (getf (sub-data fish) :dying) :to-be-truthy)
          (expect (cl-asciiquarium::creature-removep mark) :to-be t)
          (world-apply-key-event world (first (decode-input " ")))
          (world-advance world)
          (expect (world-paused-p world) :to-be t)
          (expect (creatures-of-kind world :stun-mark) :to-be nil)))))
  (it "stops every school member for 25 ticks under a ! even while the school scatters, then regroups"
    (with-seeded-random-state (42)
      (let ((world (sub-test-world :width 160 :height 30)))
        (multiple-value-bind (leader members) (cl-asciiquarium::spawn-school-now world)
          (cl-asciiquarium::school-scatter world leader nil)
          (loop for fish across members
                do (cl-asciiquarium::stun-effect world nil fish))
          (let ((positions (map 'list (lambda (fish) (cons (creature-x fish) (creature-y fish)))
                                members))
                (still t))
            (expect (length (creatures-of-kind world :stun-mark)) :to-be 6)
            (dotimes (tick 24)
              ;; The sonar keeps a school in range scattering every tick.
              (cl-asciiquarium::school-scatter world leader nil)
              (world-advance world)
              (unless (and (every (lambda (fish position)
                                    (and (zerop (entity-dx (sub-entity fish)))
                                         (zerop (entity-dy (sub-entity fish)))
                                         (= (creature-x fish) (car position))
                                         (= (creature-y fish) (cdr position))))
                                  members positions)
                           (= (length (creatures-of-kind world :stun-mark)) 6))
                (setf still nil)))
            (expect still :to-be t)
            (world-advance world)
            (with-soft-assertions
              (expect (length (creatures-of-kind world :stun-mark)) :to-be 0)
              (expect (loop for fish across members
                            for data = (sub-data fish)
                            always (and (= (entity-dx (sub-entity fish))
                                           (+ (getf data :school-dx) (getf data :scatter-dx)))
                                        (= (entity-dy (sub-entity fish)) (getf data :scatter-dy))))
                      :to-be-truthy))
            (advance-school-until-scatter-ends world leader)
            (dotimes (tick 60) (world-advance world))
            (expect (school-in-formation-p leader members) :to-be-truthy))))))
  (it "gives a member stunned outside a scatter the school's speed when the stun ends"
    (with-seeded-random-state (42)
      (let ((world (sub-test-world :width 160 :height 30)))
        (multiple-value-bind (leader members) (cl-asciiquarium::spawn-school-now world)
          (declare (ignore leader))
          (let ((member (aref members 1)))
            (setf (entity-dy (sub-entity member)) 0.5f0)
            (cl-asciiquarium::stun-effect world nil member)
            (dotimes (tick 25) (world-advance world))
            (expect (entity-dx (sub-entity member)) :to-be (getf (sub-data member) :school-dx))
            (expect (entity-dy (sub-entity member)) :to-be 0))))))
  (it "keeps a stunned member still when its leader dies, then gives it the school's speed"
    (with-seeded-random-state (42)
      (let ((world (sub-test-world :width 160 :height 30)))
        (multiple-value-bind (leader members) (cl-asciiquarium::spawn-school-now world)
          (let ((orphan (aref members 2)))
            (cl-asciiquarium::school-scatter world leader nil)
            (cl-asciiquarium::stun-effect world nil orphan)
            (cl-asciiquarium::eat-effect world nil leader)
            (world-advance world)
            (expect (null (getf (sub-data orphan) :leader)) :to-be t)
            (expect (entity-dx (sub-entity orphan)) :to-be 0)
            (dotimes (tick 24) (world-advance world))
            (expect (entity-dx (sub-entity orphan)) :to-be (getf (sub-data orphan) :school-dx))
            (expect (entity-dy (sub-entity orphan)) :to-be 0)))))))

(defun advance-school-until-scatter-ends (world leader)
  (loop repeat 40
        until (zerop (getf (sub-data leader) :scatter-until))
        do (world-advance world)))

(describe "the submarine and a school"
  (it "scatters a school within 26 columns and leaves one farther away alone"
    (with-seeded-random-state (42)
      (let ((world (sub-test-world :width 160 :height 30)))
        (multiple-value-bind (leader members) (cl-asciiquarium::spawn-school-now world)
          (declare (ignore leader))
          (let ((right (loop for fish across members
                             maximize (+ (floor (creature-x fish)) (creature-dimensions fish))))
                (sub (parked-sub world)))
            (setf (getf (sub-data sub) :sonar-next) most-positive-fixnum
                  (entity-x (sub-entity sub)) (+ right 27))
            (apply-collisions world)
            (expect (loop for fish across members
                          always (zerop (getf (sub-data fish) :scatter-until)))
                    :to-be-truthy)
            (decf (entity-x (sub-entity sub)))
            (apply-collisions world)
            (expect (loop for fish across members
                          always (= (+ (world-tick world) 30)
                                    (getf (sub-data fish) :scatter-until)))
                    :to-be-truthy)))))))
