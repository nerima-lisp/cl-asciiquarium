(in-package #:cl-asciiquarium/test)

(describe "vertical line capacity after reeling in"
  (it "trims every cached theme without discarding keys or changing run screens"
    (with-seeded-random-state (74)
      (let* ((cl-asciiquarium::*auto-events* nil)
             (world (make-world :width 160 :height 80 :fish-count 0))
             (dinghy (cl-asciiquarium::spawn-diver-now world :facing :right))
             (rope (cl-asciiquarium::find-creature-of-kind world :rope)))
        (setf (getf (cl-asciiquarium::creature-data dinghy) :depth) 18.0f0)
        (cl-asciiquarium::rope-tick world rope)
        (world-resize world 80 8)
        (dolist (theme '(:abyss :coral :moonlight)) (world-set-theme world theme))
        (let ((entries (loop for prototype being the hash-values
                              of cl-asciiquarium::*vertical-line-prototypes*
                            collect (list prototype
                                          (cl-asciiquarium::creature-%frames prototype)
                                          (aref (cl-asciiquarium::creature-%frame-runs prototype) 8)))))
          (expect (length entries) :to-be 3)
          (setf (getf (cl-asciiquarium::creature-data dinghy) :depth) 8.0f0)
          (cl-asciiquarium::rope-tick world rope)
          (world-set-theme world :abyss)
          (expect (hash-table-count cl-asciiquarium::*vertical-line-prototypes*) :to-be 3)
          (dolist (entry entries)
            (destructuring-bind (prototype frames runs) entry
              (expect (length frames) :to-be 19)
              (expect (length (cl-asciiquarium::creature-%frames prototype)) :to-be 9)
              (expect (aref (cl-asciiquarium::creature-%frame-runs prototype) 8) :to-be runs))))))))

(describe "fixed recoloring and mutable frame aliases"
  (it "keeps public aliases independent without retaining them"
    (let* ((cl-asciiquarium::*recolored-sprite-prototypes* (make-hash-table :test #'equal))
           (first (make-creature :kind :test :frames (string #\X) :x 0 :y 0))
           (second (make-creature :kind :test :frames (string #\X) :x 0 :y 0))
           (frames (creature-frames first))
           (style (make-style :bold)))
      (cl-asciiquarium::%set-creature-colors first :style style)
      (cl-asciiquarium::%set-creature-colors second :style style)
      (expect (cl-asciiquarium::creature-%frames first) :to-be frames)
      (expect (eq (cl-asciiquarium::creature-%frame-runs first)
                  (cl-asciiquarium::creature-%frame-runs second)) :to-be nil)
      (setf (char (aref frames 0) 0) #\x)
      (let ((screen (make-screen 1 1)))
        (cl-asciiquarium::creature-blit screen first)
        (expect (cell-char (screen-cell screen 0 0)) :to-be #\x)
        (cl-asciiquarium::creature-blit screen second)
        (expect (cell-char (screen-cell screen 0 0)) :to-be #\X))
      (expect (hash-table-count cl-asciiquarium::*recolored-sprite-prototypes*) :to-be 0)))
  (it "shares fixed internal shark art but excludes its public aliases"
    (let ((cl-asciiquarium::*recolored-sprite-prototypes* (make-hash-table :test #'equal)))
      (with-seeded-random-state (134)
        (let* ((world (make-world :width 80 :height 24 :fish-count 0))
               (first (cl-asciiquarium::make-shark world))
               (second (cl-asciiquarium::make-shark world)))
          (cl-asciiquarium::%set-world-creatures world (list first second))
          (world-set-theme world :coral)
          (expect (cl-asciiquarium::creature-%frame-runs first)
                  :to-be (cl-asciiquarium::creature-%frame-runs second))
          (let ((entries (hash-table-count cl-asciiquarium::*recolored-sprite-prototypes*))
                (frames (creature-frames first)))
            (setf (char (aref frames 0) 0) #\X)
            (world-set-theme world :coral)
            (expect (eq (cl-asciiquarium::creature-%frame-runs first)
                        (cl-asciiquarium::creature-%frame-runs second)) :to-be nil)
            (expect (hash-table-count cl-asciiquarium::*recolored-sprite-prototypes*)
                    :to-be entries)))))))

(defun %theme-cycle-allocation (bubble-count)
  (with-seeded-random-state (96)
    (let* ((world (make-world :width 80 :height 24 :fish-count 0))
           (fish (make-creature :kind :fish :frames ">o>" :x 10 :y 12)))
      (cl-asciiquarium::%set-world-creatures world nil)
      (dotimes (i bubble-count)
        (cl-asciiquarium::%add-world-creature world (cl-asciiquarium::make-bubble world fish)))
      (dotimes (i 3)
        (dolist (theme '(:abyss :coral :moonlight)) (world-set-theme world theme)))
      (sb-ext:gc :full t)
      (let ((before (sb-ext:get-bytes-consed)))
        (dotimes (i 100)
          (dolist (theme '(:abyss :coral :moonlight)) (world-set-theme world theme)))
        (- (sb-ext:get-bytes-consed) before)))))

(describe "shared recoloring and sonar prototypes"
  (it "does not add theme-cycle allocation for one hundred warmed bubbles"
    (let ((*color-mode* :truecolor))
      (let ((empty (%theme-cycle-allocation 0))
            (bubbles (%theme-cycle-allocation 100)))
        ;; Repeated calls make per-bubble allocation accumulate above the
        ;; small counter fluctuations seen between otherwise identical runs.
        (expect (< (abs (- bubbles empty)) 65536) :to-be t))))
  (it "never rebuilds warmed sonar runs"
    (with-seeded-random-state (97)
      (let* ((world (make-world :width 80 :height 24 :fish-count 0))
             (sub (cl-asciiquarium::make-submarine world :facing :right))
             (first (cl-asciiquarium::make-sonar-ring world sub))
             (second (cl-asciiquarium::make-sonar-ring world sub)))
        (expect (cl-asciiquarium::creature-%frame-runs first)
                :to-be (cl-asciiquarium::creature-%frame-runs second))
        (sb-ext:gc :full t)
        (let ((before (sb-ext:get-bytes-consed)))
          (dotimes (i 200) (cl-asciiquarium::make-sonar-ring world sub))
          (expect (< (- (sb-ext:get-bytes-consed) before) (* 200 1024)) :to-be t))))))

(describe "shared fishing line prototypes"
  (it "reuses fishing line runs when boat depths alternate"
    (with-seeded-random-state (93)
      (let* ((world (make-world :width 80 :height 48 :fish-count 0))
             (boat (cl-asciiquarium::make-fisher world :facing :right))
             (data (cl-asciiquarium::creature-data boat))
             (line (getf data :line))
             (runs (cl-asciiquarium::creature-%frame-runs line)))
        (dolist (depth '(3 7 12 7 3))
          (setf (getf data :depth) (float depth 1.0f0))
          (cl-asciiquarium::fishing-line-tick world line)
          (cl-asciiquarium::restyle-fisher-part world line)
          (expect (cl-asciiquarium::creature-frame-index line) :to-be (1- depth))
          (expect (cl-asciiquarium::creature-%frame-runs line) :to-be runs))))))

(describe "shared vertical line prototypes"
  (it "shares chain runs across lengths on the same screen"
    (with-seeded-random-state (91)
      (multiple-value-bind (world ship) (%anchor-ship-world :height 48)
        (let ((anchor (cl-asciiquarium::make-anchor world ship))
              (runs nil))
          (dolist (length '(0 1 8 20 40 1 20))
            (let ((chain (cl-asciiquarium::make-chain world anchor 5)))
              (cl-asciiquarium::%set-chain-length world chain length 40)
              (expect (cl-asciiquarium::creature-frame-index chain) :to-be length)
              (pushnew (cl-asciiquarium::creature-%frame-runs chain) runs :test #'eq)))
          (expect (length runs) :to-be 1)))))
  (it "allocates only the chain instance after warming the screen prototype"
    (with-seeded-random-state (91)
      (multiple-value-bind (world ship) (%anchor-ship-world :height 48)
        (let ((anchor (cl-asciiquarium::make-anchor world ship)))
          (dotimes (i 10) (cl-asciiquarium::make-chain world anchor 5))
          (sb-ext:gc :full t)
          (let ((before (sb-ext:get-bytes-consed)))
            (dotimes (i 200) (cl-asciiquarium::make-chain world anchor 5))
            (expect (< (- (sb-ext:get-bytes-consed) before) (* 200 1024))
                    :to-be t))))))
  (it "retains a long active rope through shrinking and recoloring"
    (with-seeded-random-state (74)
      (let* ((cl-asciiquarium::*auto-events* nil)
             (*color-mode* :truecolor)
             (world (make-world :width 160 :height 80 :fish-count 0))
             (dinghy (cl-asciiquarium::spawn-diver-now world :facing :right))
             (data (cl-asciiquarium::creature-data dinghy))
             (rope (cl-asciiquarium::find-creature-of-kind world :rope)))
        (expect (%advance-until world (lambda () (>= (getf data :depth) 18))) :to-be t)
        (world-resize world 80 8)
        (dolist (theme '(:moonlight :coral :abyss :moonlight))
          (world-set-theme world theme)
          (expect (cl-asciiquarium::creature-frame-index rope) :to-be 18)
          (expect (length (cl-asciiquarium::creature-%frames rope)) :to-be 19)
          (expect (cl-asciiquarium::creature-%style rope)
                  :to-equal (cl-asciiquarium::world-style world :white))
          (cl-asciiquarium::rope-tick world rope)
          (let ((screen (make-screen 80 8)))
            (cl-asciiquarium::creature-blit screen rope)
            (expect (cell-char (screen-cell screen 76 6)) :to-be #\|)
            (expect (cell-char (screen-cell screen 76 7)) :to-be #\|)))
        (expect (<= (hash-table-count cl-asciiquarium::*vertical-line-prototypes*) 3) :to-be t))))
  (it "bounds cached variants by spec, theme, color mode and ASCII mode"
    (let ((cl-asciiquarium::*vertical-line-prototypes* (make-hash-table :test #'equal))
          (cl-asciiquarium::*vertical-line-prototype-width* 0)
          (cl-asciiquarium::*vertical-line-prototype-height* 0))
      (with-seeded-random-state (91)
        (multiple-value-bind (world ship) (%anchor-ship-world :height 48)
          (let ((anchor (cl-asciiquarium::make-anchor world ship)))
            (dolist (*color-mode* '(:mono :ansi16 :ansi256 :truecolor))
              (dolist (*ascii* '(nil t))
                (dolist (theme '(:abyss :coral :moonlight))
                  (setf (cl-asciiquarium::world-theme world) theme)
                  (dotimes (i 8)
                    (cl-asciiquarium::make-chain world anchor 5)))))
            (expect (hash-table-count cl-asciiquarium::*vertical-line-prototypes*) :to-be 24)))))))

(describe "bounded recoloring prototypes"
  (it "does not retain changing panel contents across notifications and themes"
    (let ((cl-asciiquarium::*recolored-sprite-prototypes* (make-hash-table :test #'equal)))
      (with-seeded-random-state (130)
        (let ((world (make-world :width 80 :height 24 :fish-count 0)))
          (cl-asciiquarium::%set-world-creatures
           world (list (cl-asciiquarium::make-hud world)
                       (cl-asciiquarium::make-help-overlay world)
                       (cl-asciiquarium::make-zukan-overlay world)))
          (dotimes (i 60)
            (cl-asciiquarium::world-notify world (format nil "Notification ~D" i))
            (dolist (theme '(:abyss :coral :moonlight))
              (world-set-theme world theme)))
          (expect (hash-table-count cl-asciiquarium::*recolored-sprite-prototypes*)
                  :to-be 0)))))
  (it "does not retain flash recolorings across repeated resizes"
    (let ((*color-mode* :truecolor)
          (cl-asciiquarium::*recolored-sprite-prototypes* (make-hash-table :test #'equal))
          (cl-asciiquarium::*decor-prototypes* (make-hash-table :test #'equal))
          (cl-asciiquarium::*decor-prototype-width* 0)
          (cl-asciiquarium::*decor-prototype-height* 0))
      (with-seeded-random-state (131)
        (let ((world (make-world :width 80 :height 24 :fish-count 0)))
          (dotimes (i 60)
            (cl-asciiquarium::%set-world-creatures world nil)
            (world-resize world (+ 81 i) (+ 24 (mod i 2)))
            (cl-asciiquarium::%set-world-creatures
             world (list (cl-asciiquarium::make-flash world 10)))
            (dolist (theme '(:abyss :coral :moonlight))
              (world-set-theme world theme))
            (expect (hash-table-count cl-asciiquarium::*recolored-sprite-prototypes*)
                    :to-be 0)))))))

(describe "vertical line spec keys"
  (it "keeps distinct styles and starting lengths for specs with the same glyph"
    (let ((cl-asciiquarium::*vertical-line-prototypes* (make-hash-table :test #'equal))
          (cl-asciiquarium::*vertical-line-prototype-width* 0)
          (cl-asciiquarium::*vertical-line-prototype-height* 0)
          (*color-mode* :truecolor))
      (let* ((world (make-world :width 80 :height 24 :fish-count 0))
             (first-spec cl-asciiquarium::+chain-line-spec+)
             (second-spec (list (first first-spec) 0
                                (lambda (theme)
                                  (cl-asciiquarium::visual-style theme :white))))
             (third-spec (list (first first-spec) 1 (third first-spec)))
             (first (cl-asciiquarium::%vertical-line-prototype world first-spec))
             (second (cl-asciiquarium::%vertical-line-prototype world second-spec))
             (third (cl-asciiquarium::%vertical-line-prototype world third-spec)))
        (expect (eq first second) :to-be nil)
        (expect (equal (cl-asciiquarium::creature-%style first)
                       (cl-asciiquarium::creature-%style second)) :to-be nil)
        (expect (length (cl-asciiquarium::creature-%frames third)) :to-be 24)
        (expect (cl-asciiquarium::%vertical-line-prototype world first-spec) :to-be first)
        (expect (hash-table-count cl-asciiquarium::*vertical-line-prototypes*) :to-be 3)))))

(describe "recoloring excludes variable and public art"
  (it "does not retain flashes at varying positions without resizing"
    (let ((*color-mode* :truecolor)
          (cl-asciiquarium::*recolored-sprite-prototypes* (make-hash-table :test #'equal)))
      (with-seeded-random-state (131)
        (let ((world (make-world :width 160 :height 24 :fish-count 0)))
          (dotimes (x 60)
            (cl-asciiquarium::%set-world-creatures
             world (list (cl-asciiquarium::make-flash world x)))
            (dolist (theme '(:abyss :coral :moonlight))
              (world-set-theme world theme))
            (expect (hash-table-count cl-asciiquarium::*recolored-sprite-prototypes*)
                    :to-be 0))))))
  (it "does not retain frames supplied through public restyler registration"
    (let ((cl-asciiquarium::*creature-restylers* (make-hash-table :test #'eq))
          (cl-asciiquarium::*recolored-sprite-prototypes* (make-hash-table :test #'equal)))
      (register-named-color-restyler :custom :white)
      (let ((world (make-world :width 80 :height 24 :fish-count 0)))
        (dotimes (i 60)
          (let ((creature (make-creature :kind :custom :frames (format nil "custom ~D" i)
                                         :x 0 :y 0)))
            (cl-asciiquarium::%set-world-creatures world (list creature))
            (dolist (theme '(:abyss :coral :moonlight)) (world-set-theme world theme))))
        (expect (hash-table-count cl-asciiquarium::*recolored-sprite-prototypes*) :to-be 0))))
  (it "does not retain public frame replacements on an internally restyled shark"
    (let ((cl-asciiquarium::*recolored-sprite-prototypes* (make-hash-table :test #'equal)))
      (with-seeded-random-state (132)
        (let* ((world (make-world :width 80 :height 24 :fish-count 0))
               (shark (cl-asciiquarium::make-shark world)))
          (cl-asciiquarium::%set-world-creatures world (list shark))
          (dotimes (i 60)
            (setf (creature-frames shark) (vector (format nil "public ~D" i)))
            (dolist (theme '(:abyss :coral :moonlight)) (world-set-theme world theme)))
          (expect (hash-table-count cl-asciiquarium::*recolored-sprite-prototypes*) :to-be 0)))))
  (it "does not retain mutations through a public frame string alias"
    (let ((cl-asciiquarium::*recolored-sprite-prototypes* (make-hash-table :test #'equal)))
      (with-seeded-random-state (133)
        (let* ((world (make-world :width 80 :height 24 :fish-count 0))
               (shark (cl-asciiquarium::make-shark world))
               (frames (creature-frames shark)))
          (cl-asciiquarium::%set-world-creatures world (list shark))
          (dotimes (i 26)
            (setf (char (aref frames 0) 0) (code-char (+ (char-code #\A) i)))
            (world-set-theme world :coral)
            (expect (cl-asciiquarium::creature-%frames shark) :to-be frames)
            (expect (char (aref (cl-asciiquarium::creature-%prepared-frames shark) 0) 0)
                    :to-be (code-char (+ (char-code #\A) i))))
          (expect (hash-table-count cl-asciiquarium::*recolored-sprite-prototypes*) :to-be 0))))))
