;;;; t/food-test.lisp -- food grains: sprinkling, sinking, luring, eating,
;;;; and the mouse dispatch that sprinkles them.
(in-package #:cl-asciiquarium/test)

(defun food-world ()
  "An 80x24 tank with no fish, no shark, and none of the residents that
catch fish (the octopus, the gulls): swim band rows 7..19."
  (remove-gulls
   (remove-octopus (make-world :width 80 :height 24 :fish-count 0 :shark-enabled-p nil))))

(defun world-food (world)
  (remove :food (cl-asciiquarium::world-%creatures world)
          :key #'cl-asciiquarium::creature-kind :test-not #'eq))

(defun add-food (world x y)
  (cl-asciiquarium::%add-world-creature world (cl-asciiquarium::make-food world x y)))

(defun add-dart (world x y dx)
  (cl-asciiquarium::%add-world-creature
   world (make-fish world :species :dart :x x :y y :dx dx :facing (if (minusp dx) :left :right))))

(defun center-distance (a b)
  (multiple-value-bind (aw ah) (creature-dimensions a)
    (multiple-value-bind (bw bh) (creature-dimensions b)
      (let ((dx (- (+ (creature-x a) (* 0.5 aw)) (+ (creature-x b) (* 0.5 bw))))
            (dy (- (+ (creature-y a) (* 0.5 ah)) (+ (creature-y b) (* 0.5 bh)))))
        (sqrt (+ (* dx dx) (* dy dy)))))))

(defun fish-position (fish)
  (list (creature-x fish) (creature-y fish)))

(defun mouse-report (cb x y final)
  "The SGR mouse report for button byte CB at 1-based X Y, FINAL #\\M or #\\m."
  (format nil "~C[<~D;~D;~D~C" #\Escape cb x y final))

(defvar *food-effect-calls* 0)

(defun counting-food-effect (world food fish)
  (incf *food-effect-calls*)
  (cl-asciiquarium::food-eaten-effect world food fish))

(describe "food: sprinkling and expiry"
  (it "spawn-food-now adds six grains that are gone after 400 ticks"
    (with-seeded-random-state (11)
      (let ((world (food-world)))
        (cl-asciiquarium::spawn-food-now world 40 7 6)
        (expect (length (world-food world)) :to-be 6)
        (dolist (food (world-food world))
          (expect (<= 38 (creature-x food) 42) :to-be-truthy)
          (expect (creature-y food) :to-be 7))
        (dotimes (i 399) (world-advance world))
        (expect (length (world-food world)) :to-be 6)
        (world-advance world)
        (expect (length (world-food world)) :to-be 0))))
  (it "keeps a grain inside the tank's columns at the edge"
    (with-seeded-random-state (11)
      (let ((world (food-world)))
        (cl-asciiquarium::spawn-food-now world 0 7 6)
        (cl-asciiquarium::spawn-food-now world 79 7 6)
        (expect (every (lambda (food) (<= 0 (creature-x food) 79)) (world-food world))
                :to-be-truthy))))
  (it "adds nothing while 18 grains exist, and fills only up to 18 from 17"
    (with-seeded-random-state (11)
      (let ((world (food-world)))
        (dotimes (i 17) (add-food world 40 10))
        (cl-asciiquarium::world-scatter-food world)
        (expect (length (world-food world)) :to-be 18)
        (let ((world (food-world)))
          (dotimes (i 18) (add-food world 40 10))
          (cl-asciiquarium::spawn-food-now world 40 7 3)
          (expect (length (world-food world)) :to-be 18)))))
  (it "world-scatter-food sprinkles six grains on the top swim row in the middle half"
    (with-seeded-random-state (11)
      (let ((world (food-world)))
        (cl-asciiquarium::world-scatter-food world)
        (expect (length (world-food world)) :to-be 6)
        (dolist (food (world-food world))
          (expect (<= (- 20 2) (creature-x food) (+ 60 2)) :to-be-truthy)
          (expect (creature-y food) :to-be (world-swim-band world))))))
  (it "places the same grains for the same seed"
    (flet ((grains ()
             (with-seeded-random-state (23)
               (let ((world (food-world)))
                 (cl-asciiquarium::world-scatter-food world)
                 (mapcar #'creature-x (world-food world))))))
      (expect (grains) :to-equal (grains)))))

(describe "food: sinking and art"
  (it "sinks 0.05 rows per tick and stops at the bottom of the swim band"
    (let ((world (food-world)))
      (add-food world 40 7)
      (let ((food (first (world-food world))))
        (world-advance world)
        (expect (creature-y food) :to-be (+ 7 0.05f0))
        (dotimes (i 300) (world-advance world))
        (expect (creature-y food) :to-be (nth-value 1 (world-swim-band world)))
        (expect (entity-dy (cl-asciiquarium::creature-entity food)) :to-be 0))))
  (it "sinks again after a resize lowers the bottom under a resting grain"
    (let ((world (food-world)))
      (add-food world 40 7)
      (let ((food (first (world-food world))))
        (dotimes (i 245) (world-advance world))
        (expect (creature-y food) :to-be 19)
        (world-resize world 80 34)
        ;; Motion runs before :TICK, so the restored DY moves it from the
        ;; second tick on.
        (world-advance world)
        (world-advance world)
        (expect (creature-y food) :to-be (+ 19 0.05f0))
        (dotimes (i 100) (world-advance world))
        (expect (< 24 (creature-y food) (nth-value 1 (world-swim-band world))) :to-be-truthy))))
  (it "neither sinks nor ages while paused, and sinks once resumed"
    (with-seeded-random-state (11)
      (let ((world (food-world)))
        (setf (world-paused-p world) t)
        (cl-asciiquarium::world-scatter-food world)
        (let ((food (first (world-food world))))
          (dotimes (i 50) (world-advance world))
          (expect (creature-y food) :to-be 7)
          (expect (cl-asciiquarium::creature-ttl food) :to-be 400)
          (expect (cl-asciiquarium::creature-removep food) :to-be-falsy)
          (setf (world-paused-p world) nil)
          (world-advance world)
          (expect (creature-y food) :to-be (+ 7 0.05f0))))))
  (it "draws a dot, or o under --ascii, sharing one prototype per mode"
    (let ((world (food-world)))
      (expect (creature-art (cl-asciiquarium::make-food world 1 7)) :to-equal "•")
      (expect (cl-asciiquarium::creature-%frames (cl-asciiquarium::make-food world 1 7))
              :to-be (cl-asciiquarium::creature-%frames (cl-asciiquarium::make-food world 2 7)))
      (let ((*ascii* t))
        (expect (creature-art (cl-asciiquarium::make-food world 1 7)) :to-equal "o"))
      (let ((*color-mode* :truecolor))
        (expect (cl-asciiquarium::creature-%style (cl-asciiquarium::make-food world 1 7))
                :to-equal (color-style :food :theme :abyss)))))
  (it "repaints in the new theme's background without moving"
    (let ((*color-mode* :truecolor)
          (world (food-world)))
      (add-food world 40 7)
      (let ((food (first (world-food world))))
        (world-set-theme world :coral)
        (expect (cl-asciiquarium::creature-%style food)
                :to-equal (color-style :food :theme :coral))
        (expect (fish-position food) :to-equal (list 40 7))))))

(describe "food: luring and eating"
  (it "draws a fish swimming toward it closer every tick until it eats it and lives"
    (let* ((world (food-world))
           (food (add-food world 40 8))
           (fish (add-dart world 10 13 0.25f0)))
      ;; Ten empty columns between the dart's right edge and the grain.
      (setf (entity-x (cl-asciiquarium::creature-entity fish))
            (- 40 10 (creature-dimensions fish)))
      (let ((distance (center-distance food fish)))
        (loop repeat 100
              until (cl-asciiquarium::creature-removep food)
              do (world-advance world)
                 (unless (cl-asciiquarium::creature-removep food)
                   (let ((next (center-distance food fish)))
                     (expect (< next distance) :to-be-truthy)
                     (setf distance next))))
        (expect (cl-asciiquarium::creature-removep food) :to-be-truthy)
        (expect (cl-asciiquarium::alive-fish-p fish) :to-be-truthy)
        (expect (getf (cl-asciiquarium::creature-data food) :threat) :to-be nil)
        (expect (world-food world) :to-be nil))))
  (it "pulls by at most one column and a quarter row"
    (let* ((world (food-world))
           (food (add-food world 40 8))
           (fish (add-dart world 25 14 0.25f0))
           (before (fish-position fish)))
      (cl-asciiquarium::food-tick world food)
      (expect (fish-position fish) :to-equal (list (+ (first before) 1.0f0)
                                                   (- (second before) 0.25f0)))))
  (it "keeps a pulled fish inside its swim limits"
    (let* ((world (food-world))
           (food (add-food world 40 19))
           (fish (add-dart world 36 16 0.25f0)))
      (setf (entity-dy (cl-asciiquarium::creature-entity food)) 0)
      (dotimes (i 20) (cl-asciiquarium::food-tick world food))
      (expect (= (creature-y fish)
                 (nth-value 1 (cl-asciiquarium::fish-swim-limits
                               world (nth-value 1 (creature-dimensions fish)))))
              :to-be-truthy)))
  (it-each ((:left-of-it-heading-left 30 -0.25f0)
            (:right-of-it-heading-right 50 0.25f0)
            (:motionless 30 0))
      "leaves a fish that is not heading for the grain (~S) alone"
      (label x dx)
    (declare (ignore label))
    (let* ((world (food-world))
           (food (add-food world 40 8))
           (fish (add-dart world x 10 dx)))
      (let ((before (fish-position fish)))
        (cl-asciiquarium::food-tick world food)
        (expect (fish-position fish) :to-equal before))))
  (it "leaves a school member alone"
    (let* ((world (food-world))
           (food (add-food world 40 8))
           (fish (add-dart world 30 10 0.25f0)))
      (setf (cl-asciiquarium::creature-data fish)
            (list* :leader fish (cl-asciiquarium::creature-data fish)))
      (let ((before (fish-position fish)))
        (cl-asciiquarium::food-tick world food)
        (expect (fish-position fish) :to-equal before))))
  ;; CREATURE-BOUNDS rounds the fish's top row half to even: 15.5 is row 16.
  (it-each ((21 10 nil) (20 10 t) (5 16 nil) (5 15 t)
            (5 15.4f0 t) (5 15.5f0 nil) (5 15.6f0 nil))
      "with ~D empty columns and a fish top at row ~A, pulls: ~S"
      (gap y expected)
    (let* ((world (food-world))
           (food (add-food world 40 8))
           (fish (add-dart world 0 y 0.25f0)))
      (setf (entity-x (cl-asciiquarium::creature-entity fish))
            (- 40 gap (creature-dimensions fish)))
      (let ((before (fish-position fish)))
        (cl-asciiquarium::food-tick world food)
        (expect (not (equal (fish-position fish) before)) :to-be expected))))
  (it "does not pull a fish on the tick the grain expires"
    (flet ((fish-step (ttl)
             (let* ((world (food-world))
                    (food (add-food world 40 8))
                    (fish (add-dart world 20 10 0.25f0))
                    (before (creature-x fish)))
               (setf (cl-asciiquarium::creature-ttl food) ttl)
               (world-advance world)
               (- (creature-x fish) before))))
      (expect (fish-step 1) :to-be 0.25f0)
      (expect (fish-step 2) :to-be 1.25f0)))
  ;; Whichever ticks last decides the jelly's row for the collision pass and
  ;; the frame: FISH-DRIFT-TICK when the grain is newer, the pull when older.
  (it-each ((:grain-after-jelly) (:grain-before-jelly))
      "pulls a drifting jelly only sideways (~S)"
      (order)
    (flet ((jelly-world (fed)
             (with-seeded-random-state (17)
               (let ((world (food-world)))
                 (when (and fed (eq order :grain-before-jelly)) (add-food world 40 10))
                 (let ((jelly (make-fish world :species :jelly :x 20 :y 10 :dx 0.05f0 :facing :right)))
                   (cl-asciiquarium::%add-world-creature world jelly)
                   (when (and fed (eq order :grain-after-jelly)) (add-food world 40 10))
                   (values world jelly))))))
      (multiple-value-bind (fed-world fed-jelly) (jelly-world t)
        (multiple-value-bind (control-world control-jelly) (jelly-world nil)
          (dotimes (i 40)
            (world-advance fed-world)
            (world-advance control-world)
            (expect (creature-y fed-jelly) :to-equal (creature-y control-jelly)))
          (expect (> (creature-x fed-jelly) (+ (creature-x control-jelly) 10)) :to-be-truthy)))))
  (it "pulls only the nearest of two lured fish"
    (let* ((world (food-world))
           (food (add-food world 40 8))
           (far (add-dart world 20 10 0.25f0))
           (near (add-dart world 30 10 0.25f0))
           (far-before (fish-position far))
           (near-before (fish-position near)))
      (cl-asciiquarium::food-tick world food)
      (expect (fish-position far) :to-equal far-before)
      (expect (equal (fish-position near) near-before) :to-be-falsy)))
  (it "is eaten once when two fish overlap it in the same tick"
    (let* ((world (food-world))
           (food (add-food world 40 10))
           (first-fish (add-dart world 37 9 0))
           (second-fish (add-dart world 38 9 0))
           (*food-effect-calls* 0))
      (setf (getf (cl-asciiquarium::creature-data food) :threat)
            '(:grip :body :effect counting-food-effect :prey nil :alarm nil))
      (world-advance world)
      (expect *food-effect-calls* :to-be 1)
      (expect (world-food world) :to-be nil)
      (expect (cl-asciiquarium::alive-fish-p first-fish) :to-be-truthy)
      (expect (cl-asciiquarium::alive-fish-p second-fish) :to-be-truthy))))

(describe "food: allocation"
  (flet ((bytes-consed-by-ticks (world food)
           (dotimes (i 100) (cl-asciiquarium::food-tick world food))
           (let ((before (sb-ext:get-bytes-consed)))
             (dotimes (i 10000) (cl-asciiquarium::food-tick world food))
             (- (sb-ext:get-bytes-consed) before))))
    (it "food-tick conses nothing while it pulls a fish or finds none"
      (with-seeded-random-state (5)
        (let* ((world (make-world :width 80 :height 24 :fish-count 18 :shark-enabled-p nil))
               (food (add-food world 40 12)))
          (add-dart world 30 12 0.25f0)
          (expect (bytes-consed-by-ticks world food) :to-be 0)
          (let* ((empty (food-world))
                 (lonely (add-food empty 40 12)))
            (expect (bytes-consed-by-ticks empty lonely) :to-be 0)))))))

(describe "food: mouse dispatch"
  (it "a left press among key events sprinkles three grains around the clicked cell"
    (with-seeded-random-state (11)
      (let ((world (food-world)))
        (world-apply-key-events
         world (decode-input (concatenate 'string "x" (mouse-report 0 11 8 #\M) "q")))
        (expect (world-quitp world) :to-be-truthy)
        (expect (length (world-food world)) :to-be 3)
        (dolist (food (world-food world))
          (expect (<= 8 (creature-x food) 12) :to-be-truthy)
          (expect (creature-y food) :to-be 7)))))
  (it-each ((1 7) (24 19))
      "clamps a click on row ~D into the swim band at row ~D"
      (row expected)
    (with-seeded-random-state (11)
      (let ((world (food-world)))
        (world-apply-key-events world (decode-input (mouse-report 0 11 row #\M)))
        (expect (mapcar #'creature-y (world-food world)) :to-equal (list expected expected expected)))))
  (it-each ((:release 0 #\m) (:right 2 #\M) (:middle 1 #\M) (:wheel 64 #\M)
            (:drag 32 #\M) (:move 35 #\M))
      "ignores a ~S report"
      (name cb final)
    (declare (ignore name))
    (let ((world (food-world)))
      (world-apply-key-events world (decode-input (mouse-report cb 11 8 final)))
      (expect (world-food world) :to-be nil))))
