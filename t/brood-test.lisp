(in-package #:cl-asciiquarium/test)

(defun brood-test-world ()
  (let ((world (tiny-world :width 80 :height 24)))
    (setf (cl-asciiquarium::world-shark-enabled-p world) nil
          (cl-asciiquarium::world-guest-cooldown world) 100000)
    world))

(defun add-brood-parent (world &optional (species :guppy))
  (let ((fish (make-fish world :species species :x 30 :y 10 :dx 0 :facing :right)))
    (cl-asciiquarium::%add-world-creature world fish)
    fish))

(describe "brood selection and collision"
  (it "uses the next collision pass to spawn one egg and heart and cool both parents"
    (with-seeded-random-state (420)
      (let* ((world (brood-test-world))
             (first (add-brood-parent world))
             (second (add-brood-parent world))
             (first-tick (getf (cl-asciiquarium::creature-data first) :tick))
             (second-tick (getf (cl-asciiquarium::creature-data second) :tick))
             (selected (cl-asciiquarium::select-courting-fish world)))
        (expect (member selected (list first second)) :to-be-truthy)
        (expect (getf (cl-asciiquarium::creature-data selected) :threat)
                :to-be cl-asciiquarium::+courting-threat+)
        (expect (cl-asciiquarium::brood-count world) :to-be 0)
        (world-advance world)
        (expect (cl-asciiquarium::brood-count world) :to-be 1)
        (let ((egg (find :egg (cl-asciiquarium::world-%creatures world) :key #'cl-asciiquarium::creature-kind))
              (heart (find :heart (cl-asciiquarium::world-%creatures world) :key #'cl-asciiquarium::creature-kind)))
          (expect egg :to-be-truthy)
          (expect heart :to-be-truthy)
          (expect (aref (creature-frames egg) 0) :to-equal "°")
          (expect (aref (creature-frames heart) 0) :to-equal "♥")
          (expect (= (creature-x egg) 30) :to-be-truthy)
          (expect (= (creature-y egg) 10) :to-be-truthy))
        (dolist (fish (list first second))
          (expect (getf (cl-asciiquarium::creature-data fish) :mate-ready-at) :to-be 701)
          (expect (getf (cl-asciiquarium::creature-data fish) :threat) :to-be nil))
        (expect (getf (cl-asciiquarium::creature-data first) :tick) :to-be first-tick)
        (expect (getf (cl-asciiquarium::creature-data second) :tick) :to-be second-tick)
        (expect (cl-asciiquarium::select-courting-fish world) :to-be nil)
        (setf (cl-asciiquarium::world-tick world) 700)
        (expect (cl-asciiquarium::select-courting-fish world) :to-be nil)
        (setf (cl-asciiquarium::world-tick world) 701)
        (expect (cl-asciiquarium::select-courting-fish world) :to-be-truthy))))
  (it "does not mate different species or fish still cooling down"
    (with-seeded-random-state (421)
      (let* ((world (brood-test-world))
             (first (add-brood-parent world))
             (second (add-brood-parent world :clown)))
        (cl-asciiquarium::select-courting-fish world)
        (world-advance world)
        (expect (cl-asciiquarium::brood-count world) :to-be 0)
        (setf (getf (cl-asciiquarium::creature-data first) :mate-ready-at) 900
              (getf (cl-asciiquarium::creature-data second) :mate-ready-at) 900)
        (expect (cl-asciiquarium::select-courting-fish world) :to-be nil)
        (expect (getf (cl-asciiquarium::creature-data first) :threat) :to-be nil)
        (expect (getf (cl-asciiquarium::creature-data second) :threat) :to-be nil))))
  (it "retires an unmatched row at the next selection without replacing the fish tick"
    (with-seeded-random-state (422)
      (let* ((world (brood-test-world))
             (fish (add-brood-parent world))
             (tick (getf (cl-asciiquarium::creature-data fish) :tick)))
        (expect (cl-asciiquarium::select-courting-fish world) :to-be fish)
        (world-advance world)
        (expect (getf (cl-asciiquarium::creature-data fish) :threat)
                :to-be cl-asciiquarium::+courting-threat+)
        (setf (getf (cl-asciiquarium::creature-data fish) :mate-ready-at) 700)
        (expect (cl-asciiquarium::select-courting-fish world) :to-be nil)
        (expect (getf (cl-asciiquarium::creature-data fish) :threat) :to-be nil)
        (expect (getf (cl-asciiquarium::creature-data fish) :tick) :to-be tick))))
  (it "preserves existing species threats and never selects a dying parent"
    (with-seeded-random-state (423)
      (let* ((world (brood-test-world))
             (lantern (add-brood-parent world :lantern))
             (row (getf (cl-asciiquarium::creature-data lantern) :threat))
             (dying (add-brood-parent world)))
        (expect row :to-be-truthy)
        (cl-asciiquarium::kill-fish dying)
        (expect (cl-asciiquarium::select-courting-fish world) :to-be nil)
        (expect (getf (cl-asciiquarium::creature-data lantern) :threat) :to-be row))))
  (it "creates only one egg from three overlapping parents when two broods exist"
    (with-seeded-random-state (424)
      (let ((world (brood-test-world)))
        (dotimes (i 3) (add-brood-parent world))
        (dotimes (i 2)
          (cl-asciiquarium::%add-world-creature
           world (cl-asciiquarium::make-egg world :guppy 20 10)))
        (cl-asciiquarium::select-courting-fish world)
        (world-advance world)
        (expect (cl-asciiquarium::brood-count world) :to-be 3)
        (expect (count :heart (cl-asciiquarium::world-%creatures world) :key #'cl-asciiquarium::creature-kind)
                :to-be 1)
        (expect (count-if (lambda (fish)
                            (and (cl-asciiquarium::alive-fish-p fish)
                                 (= (getf (cl-asciiquarium::creature-data fish) :mate-ready-at) 701)))
                          (cl-asciiquarium::world-%creatures world))
                :to-be 2)
        (expect (cl-asciiquarium::select-courting-fish world) :to-be nil)))))

(describe "brood growth"
  (it "hatches at 100 ticks and grows into the same species after another 220 ticks"
    (with-seeded-random-state (425)
      (let* ((world (brood-test-world))
             (egg (cl-asciiquarium::make-egg world :guppy 30 10)))
        (cl-asciiquarium::%add-world-creature world egg)
        (dotimes (i 99) (world-advance world))
        (expect (cl-asciiquarium::creature-kind egg) :to-be :egg)
        (world-advance world)
        (expect (cl-asciiquarium::creature-kind egg) :to-be :fry)
        (expect (aref (creature-frames egg) 0) :to-equal "°>")
        (dotimes (i 219) (world-advance world))
        (expect (cl-asciiquarium::creature-kind egg) :to-be :fry)
        (expect (count-if #'cl-asciiquarium::alive-fish-p (cl-asciiquarium::world-%creatures world)) :to-be 0)
        (world-advance world)
        (expect (member egg (cl-asciiquarium::world-%creatures world)) :to-be nil)
        (let ((adult (find-if #'cl-asciiquarium::alive-fish-p (cl-asciiquarium::world-%creatures world))))
          (expect adult :to-be-truthy)
          (expect (getf (cl-asciiquarium::creature-data adult) :species) :to-be :guppy)
          (expect (= (creature-x adult) 30) :to-be-truthy)
          (expect (= (creature-y adult) 10) :to-be-truthy)))))
  (it "waits as fry at max-fish and grows when a live-fish slot opens"
    (with-seeded-random-state (426)
      (let* ((world (brood-test-world))
             (parent (add-brood-parent world))
             (egg (cl-asciiquarium::make-egg world :guppy 30 10)))
        (setf (cl-asciiquarium::world-max-fish world) 1)
        (cl-asciiquarium::%add-world-creature world egg)
        (dotimes (i 325) (world-advance world))
        (expect (cl-asciiquarium::creature-kind egg) :to-be :fry)
        (expect (cl-asciiquarium::creature-removep egg) :to-be nil)
        (expect (count-if #'cl-asciiquarium::alive-fish-p (cl-asciiquarium::world-%creatures world)) :to-be 1)
        (cl-asciiquarium::kill-fish parent)
        (world-advance world)
        (expect (cl-asciiquarium::creature-removep egg) :to-be-truthy)
        (expect (count-if #'cl-asciiquarium::alive-fish-p (cl-asciiquarium::world-%creatures world)) :to-be 1))))
  (it "counts eggs and fry together and clears an old selection at the cap"
    (with-seeded-random-state (427)
      (let* ((world (brood-test-world))
             (parent (add-brood-parent world))
             (fry (cl-asciiquarium::make-egg world :guppy 30 10)))
        (cl-asciiquarium::select-courting-fish world)
        (cl-asciiquarium::%add-world-creature world fry)
        (dotimes (i 100) (world-advance world))
        (expect (cl-asciiquarium::creature-kind fry) :to-be :fry)
        (dotimes (i 2)
          (cl-asciiquarium::%add-world-creature
           world (cl-asciiquarium::make-egg world :guppy 30 10)))
        (expect (cl-asciiquarium::brood-count world) :to-be 3)
        (expect (cl-asciiquarium::select-courting-fish world) :to-be nil)
        (expect (getf (cl-asciiquarium::creature-data parent) :threat) :to-be nil))))
  (it "uses ASCII replacements for egg, fry and heart"
    (with-seeded-random-state (428)
      (let* ((cl-asciiquarium::*ascii* t)
             (world (brood-test-world))
             (egg (cl-asciiquarium::make-egg world :guppy 30 10))
             (heart (cl-asciiquarium::make-heart world 30 10)))
        (expect (aref (creature-frames egg) 0) :to-equal "o")
        (expect (aref (creature-frames heart) 0) :to-equal "*")
        (cl-asciiquarium::%add-world-creature world egg)
        (dotimes (i 100) (world-advance world))
        (expect (aref (creature-frames egg) 0) :to-equal "o>")))))
